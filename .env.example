# Optional development fallback. macOS Settings can save provider keys to Keychain.
# Never commit real credentials; .env is ignored by Git.
GEMINI_API_KEY=
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-auto
OPENROUTER_API_KEY=

# Optional custom OpenAI-compatible provider; remote URLs must use HTTPS.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Local Ollama endpoint and model. Local-only mode sends requests here.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_RESEARCHER=qwen2.5-coder:7b

# Optional local Obsidian REST API. Remote URLs are blocked by the backend.
OBSIDIAN_URL=http://127.0.0.1:27123
OBSIDIAN_API_KEY=

# Backend settings. Keep HOST on loopback for the desktop app.
HOST=127.0.0.1
PORT=8000
DEV_MODE=false
CHAT_RATE_LIMIT=30/minute
SESSION_MAX_PER_DAY=999
SESSION_DURATION_HOURS=1
HTTP_TIMEOUT=90
NET_CHECK_TIMEOUT=4

# Optional local data directory for study progress; defaults to the OS user-data folder.
COLIDEV_DATA_DIR=
