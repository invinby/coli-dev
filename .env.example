# ============================================================
# 🔑 КЛЮЧИ ДОСТУПА — coli-dev
# ============================================================
# 📌 Инструкция:
#   1. Скопируй этот файл:  cp .env.example .env
#   2. Вставь свои ключи вместо "твой_ключ_сюда"
#   3. .env уже в .gitignore — не попадёт в git!
# ============================================================

# 🥇 OpenRouter API — для Gemini/Freebuff через оркестратор
# Получить ключ: https://openrouter.ai/keys (залогинься → Create Key)
OPENROUTER_API_KEY="твой_ключ_openrouter_сюда"

# Google AI Studio / Gemini API (для Claude Code + Gemini 3.5 Flash)
# Получить: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="твой_ключ_google_ai_studio_сюда"

# Moonshot AI / Kimi K3 (для Kimi Code + Верховный Судья)
# Получить: https://platform.kimi.ai/
KIMI_API_KEY="твой_ключ_kimi_сюда"

# Zhipu AI / GLM 5.2 (опционально, для генератора)
# Получить: https://open.bigmodel.cn/
ZHIPU_API_KEY="твой_ключ_zhipu_сюда"

# Obsidian (опционально, для автосохранения сессий)
# Получить: Настройки → Подключения → Remote API
OBSIDIAN_API_KEY="твой_ключ_obsidian_сюда"
